# JWT Auth
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Fernet key for encrypting OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Databricks OAuth app — register once in your workspace:
#   Databricks workspace → Settings → Developer → App registrations → Register an app
#   Redirect URI to register: http://localhost:8000/api/connections/oauth/callback
#   After saving, copy the Client ID and paste it below.
DATABRICKS_OAUTH_CLIENT_ID=

# OAuth URLs (change host/port if not running locally)
OAUTH_REDIRECT_URI=http://localhost:8000/api/connections/oauth/callback
FRONTEND_URL=http://localhost:5173
